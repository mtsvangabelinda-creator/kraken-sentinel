# ============================================================================
# KRAKEN SENTINEL V15.0 - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env in the functions directory
# Fill in your actual values - DO NOT commit .env to GitHub
# ============================================================================

# ============================================================================
# KRAKEN API CREDENTIALS
# ============================================================================
# Get these from: https://www.kraken.com/u/settings/api
# Required: Yes
# Used by: execute_trade.py, fetch_ohlcv.py, check_positions.py, close_trade.py

KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# ============================================================================
# LLM PROVIDERS
# ============================================================================

# PRIMARY: GROQ (Llama 3.3 70B) - Free tier available
# Get API key: https://console.groq.com/keys
# Required: Yes
# Used by: llm_strategist.py (primary)

GROQ_API_KEY=your_groq_api_key_here

# FALLBACK: OpenRouter (alternative LLM provider)
# Get API key: https://openrouter.ai/keys
# Required: Yes (for failover if Groq unavailable)
# Used by: llm_strategist.py (failover)

OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================================================
# NOTIFICATION SERVICES
# ============================================================================

# TELEGRAM BOT - For trade alerts and commands
# Get token: https://t.me/BotFather
# Get chat ID: Message @userinfobot
# Required: Yes
# Used by: send_notification.py, telegram_commands.py

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# FIREBASE CLOUD MESSAGING (FCM) - For push notifications
# Get key: Firebase Console -> Project Settings -> Cloud Messaging
# Required: No (optional for mobile notifications)
# Used by: send_notification.py

FCM_SERVER_KEY=your_fcm_server_key_here

# ============================================================================
# FIREBASE CONFIGURATION
# ============================================================================

# Firebase Project ID
# Get from: Firebase Console -> Project Settings
# Required: Yes
# Used by: All modules via firebase_admin

FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Service Account (JSON - base64 encoded or path)
# Get from: Firebase Console -> Project Settings -> Service Accounts
# Can be:
#   1. Path to service account JSON file
#   2. Base64-encoded JSON string
# Required: Yes
# Used by: helpers.py (firestore client initialization)

FIREBASE_SERVICE_ACCOUNT=path/to/service-account.json
# OR
FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json

# Firebase Hosting URL (for dashboards, webhooks)
# Format: https://project-id.web.app
# Required: No (auto-determined from Firebase)
# Used by: send_notification.py (links in messages)

FIREBASE_HOSTING_URL=https://your-project-id.web.app

# ============================================================================
# STRATEGY CONFIGURATION
# ============================================================================

# Capital allocation (USD)
# Used by: execute_trade.py for position sizing
# Recommendation: Start small ($100-$300) for testing

CAPITAL_POOL_USD=300

# Maximum simultaneous positions (per strategy)
# Used by: execute_trade.py, risk_manager.py
# Recommendation: 2-3 for Phase 1

MAX_POSITIONS_PER_STRATEGY=2

# Daily loss limit (USD or percent)
# Used by: risk_manager.py for circuit breaker
# Recommendation: 5% of capital pool

DAILY_LOSS_LIMIT_USD=15
DAILY_LOSS_LIMIT_PERCENT=5

# Maximum drawdown (percent)
# Used by: risk_manager.py for circuit breaker
# Recommendation: -10% (aggressive) to -15% (conservative)

MAX_DRAWDOWN_PERCENT=-10

# ============================================================================
# APPROACH B (MOMENTUM) PARAMETERS
# ============================================================================

# Z-score threshold for breakout detection
# Range: 1.0 - 3.0
# Default: 1.6

APPROACH_B_Z_SCORE=1.6

# Take profit percentage (as decimal, e.g., 0.05 = 5%)
# Range: 0.02 - 0.15 (2% - 15%)
# Default: 0.04 (4%)

APPROACH_B_TAKE_PROFIT_PERCENT=0.04

# Stop loss percentage
# Range: 0.01 - 0.08 (1% - 8%)
# Default: 0.03 (3%)

APPROACH_B_STOP_LOSS_PERCENT=0.03

# Hold time (minutes)
# Range: 60 - 360 (1 - 6 hours)
# Default: 180 (3 hours)

APPROACH_B_HOLD_TIME_MINUTES=180

# RSI threshold (for confirmation)
# Long: RSI > threshold
# Short: RSI < (100 - threshold)
# Range: 30 - 70
# Default: 50 (neutral)

APPROACH_B_RSI_THRESHOLD=50

# Minimum volume spike ratio
# Range: 1.5 - 3.0
# Default: 2.0

APPROACH_B_MIN_VOLUME_SPIKE=2.0

# ============================================================================
# APPROACH C (SWING) PARAMETERS
# ============================================================================

# RSI long threshold (price > MA50 + RSI > threshold)
# Range: 30 - 70
# Default: 60

APPROACH_C_RSI_LONG_THRESHOLD=60

# RSI short threshold (price < MA50 + RSI < threshold)
# Range: 30 - 70
# Default: 40

APPROACH_C_RSI_SHORT_THRESHOLD=40

# Moving average period
# Range: 20 - 100
# Default: 50

APPROACH_C_MA_PERIOD=50

# Minimum volume spike ratio for confirmation
# Range: 1.0 - 3.0
# Default: 1.5

APPROACH_C_MIN_VOLUME_SPIKE=1.5

# Hold time range (minutes) - randomly chosen within range
# Long: min - max
# Short: shorter, faster exits
# Default: 240 - 1440 (4 hours - 24 hours)

APPROACH_C_LONG_HOLD_MIN_MINUTES=240
APPROACH_C_LONG_HOLD_MAX_MINUTES=1440

APPROACH_C_SHORT_HOLD_MIN_MINUTES=120
APPROACH_C_SHORT_HOLD_MAX_MINUTES=720

# ============================================================================
# GENETIC ALGORITHM PARAMETERS
# ============================================================================

# Population size (number of variants to evolve)
# Range: 5 - 20
# Default: 10

GA_POPULATION_SIZE=10

# Mutation rate (percent of population to mutate)
# Range: 0.1 - 0.5 (10% - 50%)
# Default: 0.3 (30%)

GA_MUTATION_RATE=0.3

# Evolution cycles per week
# Range: 1 - 7
# Default: 1 (weekly evolution)

GA_CYCLES_PER_WEEK=1

# Elitism (keep best N variants unchanged)
# Range: 1 - 3
# Default: 2

GA_ELITE_COUNT=2

# ============================================================================
# VALIDATION PARAMETERS
# ============================================================================

# ICIR threshold (Information Coefficient Information Ratio)
# Range: 0.1 - 0.5
# Default: 0.2

VALIDATION_ICIR_THRESHOLD=0.2

# Minimum win rate for strategy approval
# Range: 0.30 - 0.55 (30% - 55%)
# Default: 0.45 (45%)

VALIDATION_WIN_RATE_THRESHOLD=0.45

# Minimum profit factor
# Range: 1.0 - 2.0
# Default: 1.2

VALIDATION_PROFIT_FACTOR_THRESHOLD=1.2

# Maximum acceptable drawdown
# Range: -0.05 to -0.25 (-5% to -25%)
# Default: -0.15 (-15%)

VALIDATION_MAX_DRAWDOWN_THRESHOLD=-0.15

# Historical trades needed for validation
# Range: 20 - 100
# Default: 30

VALIDATION_MIN_TRADE_COUNT=30

# Rolling window count for walk-forward
# Range: 3 - 10
# Default: 5

VALIDATION_WINDOW_COUNT=5

# ============================================================================
# RISK MANAGEMENT PARAMETERS
# ============================================================================

# Kelly Criterion conservative factor
# Range: 0.2 - 1.0 (20% - 100% of Kelly)
# Default: 0.25 (25% - conservative)

KELLY_CONSERVATIVE_FACTOR=0.25

# Minimum position size (USD)
# Default: 10

MIN_POSITION_SIZE_USD=10

# Maximum position size as percent of pool
# Range: 0.05 - 0.25 (5% - 25%)
# Default: 0.10 (10%)

MAX_POSITION_SIZE_PERCENT=0.10

# Circuit breaker: max errors in rolling window
# Range: 2 - 10
# Default: 3

CIRCUIT_BREAKER_MAX_ERRORS=3

# Circuit breaker: time window (days)
# Range: 1 - 7
# Default: 3

CIRCUIT_BREAKER_ERROR_WINDOW_DAYS=3

# ============================================================================
# SCANNING PARAMETERS
# ============================================================================

# Minimum asset score for consideration
# Range: 30 - 80
# Default: 50

MIN_ASSET_SCORE=50

# Minimum 24h volume in USD
# Range: 100k - 10M
# Default: 1M ($1,000,000)

MIN_VOLUME_24H_USD=1000000

# Assets to scan (comma-separated pairs)
# Default: Top 20 coins by market cap

SCAN_ASSETS=BTCUSD,ETHUSD,ADAUSD,SOLUSD,XRPUSD

# Scan frequency (minutes)
# Range: 5 - 60
# Default: 15

SCAN_INTERVAL_MINUTES=15

# ============================================================================
# EXECUTION PARAMETERS
# ============================================================================

# Order type: "market" or "limit"
# Recommendation: "market" for immediate fills
# Default: market

ORDER_TYPE=market

# Limit order slippage (percent)
# Only used if ORDER_TYPE=limit
# Range: 0.01 - 0.5 (0.1% - 0.5%)
# Default: 0.1 (0.1%)

LIMIT_ORDER_SLIPPAGE_PERCENT=0.1

# Post-only orders? (true/false)
# For limit orders, avoid maker fees
# Default: false (market orders don't need this)

POST_ONLY_ORDERS=false

# ============================================================================
# DATA SOURCES
# ============================================================================

# OHLCV source (all free/no-key required)
# Kraken WebSocket (primary), fallback to REST
# No configuration needed - handled by fetch_ohlcv.py

# Sentiment data source: alternative.me (free)
# No API key required

# Market data: CoinPaprika (free, no key)
# Used for: Asset scoring, market context

# Funding rates: Multiple sources (Kraken, OKX free endpoints)
# Used by: Short entry confirmation

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO

LOG_LEVEL=INFO

# Enable debug mode? (true/false)
# Enables extra logging, slower execution
# Default: false

DEBUG_MODE=false

# Log file path (relative to functions/)
# Default: logs/sentinel.log

LOG_FILE_PATH=logs/sentinel.log

# Max log file size (MB)
# Default: 10

LOG_FILE_SIZE_MB=10

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable margin trading? (Phase 2)
# Phase 1: false (spot only)
# Phase 2: true (with activation flow)
# Default: false

ENABLE_MARGIN_TRADING=false

# Enable genetic algorithm evolution?
# true: continuously evolve strategy
# false: use static parameters
# Default: true

ENABLE_EVOLUTION=true

# Enable Telegram commands?
# true: respond to Telegram messages
# false: notifications only
# Default: true

ENABLE_TELEGRAM_COMMANDS=true

# Enable dry-run mode? (no actual orders)
# true: simulate all orders (for testing)
# false: place real orders
# Recommendation: true for testing
# Default: false

DRY_RUN_MODE=false

# ============================================================================
# DEPLOYMENT PARAMETERS
# ============================================================================

# Environment: "development", "staging", "production"
# Default: development

ENVIRONMENT=development

# Firebase region for Cloud Functions
# Options: us-central1, us-east1, europe-west1, asia-northeast1
# Default: us-central1

FIREBASE_REGION=us-central1

# Node.js environment
# Default: production

NODE_ENV=production

# ============================================================================
# NOTES FOR SETUP
# ============================================================================

# 1. Copy this file to functions/.env
#    cp .env.example functions/.env
#
# 2. Fill in all REQUIRED values:
#    - KRAKEN_API_KEY / KRAKEN_API_SECRET
#    - GROQ_API_KEY
#    - OPENROUTER_API_KEY
#    - TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID
#    - FIREBASE_PROJECT_ID
#    - FIREBASE_SERVICE_ACCOUNT
#
# 3. Optional: Adjust strategy parameters
#    - Start with defaults
#    - Run backtest
#    - Tune based on results
#
# 4. Never commit .env to GitHub
#    - Already in .gitignore
#    - Keep secrets safe!
#
# 5. Test locally before deploying to Firebase
#    - Use DRY_RUN_MODE=true
#    - Check logs
#    - Verify notifications work
#
# 6. Deploy to Firebase
#    - firebase deploy --only functions
#    - Monitor Cloud Function logs
#
# 7. Enable in Telegram
#    - Send /status to verify connection
#    - Check logs for errors

# ============================================================================
# VALIDATION
# ============================================================================

# Required variables check (for deployment):
# - KRAKEN_API_KEY ✓
# - KRAKEN_API_SECRET ✓
# - GROQ_API_KEY ✓
# - OPENROUTER_API_KEY ✓
# - TELEGRAM_BOT_TOKEN ✓
# - TELEGRAM_CHAT_ID ✓
# - FIREBASE_PROJECT_ID ✓
# - FIREBASE_SERVICE_ACCOUNT ✓

# Optional but recommended:
# - FCM_SERVER_KEY
# - FIREBASE_HOSTING_URL
# - LOG_LEVEL
# - DEBUG_MODE

# Strategy defaults are safe:
# - APPROACH_B_* parameters
# - APPROACH_C_* parameters
# - GA_* parameters
# - VALIDATION_* parameters
# - Risk management parameters
